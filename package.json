{
  "name": "pelican-paper",
  "private": true,
  "description": "Build tooling for the Paper Pelican theme's CSS. Not needed to use the theme.",
  "license": "MIT",
  "scripts": {
    "build": "tailwindcss -i static/css/input.css -o static/css/output.css",
    "watch": "tailwindcss -i static/css/input.css -o static/css/output.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.5",
    "tailwindcss": "4.3.5"
  }
}
